# Infrastructure Connections
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_TOPIC=news.raw.v1
KAFKA_SCORED_TOPIC=news.scored.v1
KAFKA_DEAD_LETTER_TOPIC=news.dead_letter.v1
KAFKA_CONSUMER_GROUP=sentiment-inference-workers

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/financial_news
REDIS_URL=redis://localhost:6379/0

# Model Configuration
MODEL_ID=ProsusAI/finbert
MODEL_REVISION=main
MODEL_MAX_LENGTH=128
PREPROCESS_VERSION=v1
BATCH_MAX_SIZE=16
BATCH_WAIT_MS=100
CACHE_TTL_SECONDS=2592000

# Publisher Credentials / Access Tokens (Placeholders - Authorized agreements required)
NEWS_SOURCE_REUTERS_API_KEY=mock_reuters_key_placeholder
NEWS_SOURCE_BLOOMBERG_API_KEY=mock_bloomberg_key_placeholder
NEWS_SOURCE_CNBC_API_KEY=mock_cnbc_key_placeholder
NEWS_SOURCE_MARKETWATCH_API_KEY=mock_marketwatch_key_placeholder
NEWS_SOURCE_WSJ_API_KEY=mock_wsj_key_placeholder

# Historical Window
HISTORICAL_START=2026-08-01T00:00:00Z
HISTORICAL_END=2026-11-01T00:00:00Z

# Execution Mode
BENCHMARK_MODE=replay
METRICS_PORT=8000

